<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Edge-to-edge, device-shape-aware theme.

        The window background is set to the app's own dark background color so that,
        on devices with physically rounded display corners, there is never a mismatched
        (e.g. default light/gray) color visible in the corner area behind the app's
        Compose content while the OS compositor clips the window to the display shape.
        No corner radius is hardcoded anywhere here or in code — the system handles the
        actual corner/cutout shape per device; we only make sure our background and bars
        never clash with it.
    -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>
</resources>
